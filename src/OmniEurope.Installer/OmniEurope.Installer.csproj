<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\analyzers\OmniEurope.Installer.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <!-- msi.dll exists only on Windows: the assembly is marked Windows-only (SupportedOSPlatform below, CA1416 then
         holds). Plain net11.0 rather than net11.0-windows because the oe-installer .NET tool references it and a
         .NET tool cannot target a platform (NETSDK1146). -->
    <TargetFramework>net11.0</TargetFramework>
    <!-- LibraryImport generates the msi.dll marshalling code, which needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every public member carries an XML doc (CS1591 is an error under TreatWarningsAsErrors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Version and shared package metadata: src/Directory.Build.props. -->
    <PackageId>OmniEurope.Installer</PackageId>
    <Description>Builds Windows Installer packages (MSI) and setup executables for OmniEurope desktop applications.</Description>
    <PackageTags>installer;msi;setup;eupl</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedOSPlatform Include="windows" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniEurope.Installer.Tests" />
  </ItemGroup>

</Project>
