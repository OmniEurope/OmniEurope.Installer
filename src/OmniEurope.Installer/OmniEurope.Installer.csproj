<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- msi.dll exists only on Windows: the package targets Windows explicitly (CA1416 then holds). The plain
         net11.0 flavor exists because a .NET tool cannot target a platform (NETSDK1146): the oe-installer tool
         references it, and the assembly is marked Windows-only there too. -->
    <TargetFrameworks>net11.0-windows;net11.0</TargetFrameworks>
    <!-- LibraryImport generates the msi.dll marshalling code, which needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every public member carries an XML doc (CS1591 is an error under TreatWarningsAsErrors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Version and shared package metadata: src/Directory.Build.props. -->
    <PackageId>OmniEurope.Installer</PackageId>
    <Description>Builds Windows Installer packages (MSI) and setup executables for OmniEurope desktop applications.</Description>
    <PackageTags>installer;msi;auto-update;eupl</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <SupportedOSPlatform Include="windows" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniEurope.Installer.Tests" />
  </ItemGroup>

</Project>
