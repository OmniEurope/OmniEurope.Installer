<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Both runtimes the packages support: every test runs on .NET 10 and on .NET 11. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows;net11.0-windows</TargetFrameworks>
    <!-- The tool build matching this test flavor (net10.0-windows tests run the net10.0 tool). -->
    <InstallerToolFramework>$(TargetFramework.Replace('-windows', ''))</InstallerToolFramework>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform: the test project is its own runner executable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmniEurope.Installer\OmniEurope.Installer.csproj" />
    <ProjectReference Include="..\..\src\OmniEurope.Installer.Tool\OmniEurope.Installer.Tool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\OmniEurope.Installer.Setup\OmniEurope.Installer.Setup.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logic of the net472 setup host without WinForms, compiled into the tests as it is (link). -->
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\SetupCommandLine.cs" Link="SetupHost\SetupCommandLine.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\SetupDecision.cs" Link="SetupHost\SetupDecision.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\SetupMode.cs" Link="SetupHost\SetupMode.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\MsiProgress.cs" Link="SetupHost\MsiProgress.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\InstallChoices.cs" Link="SetupHost\InstallChoices.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\ProgressAnimation.cs" Link="SetupHost\ProgressAnimation.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\LegacyBundles.cs" Link="SetupHost\LegacyBundles.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\MsiCommandLines.cs" Link="SetupHost\MsiCommandLines.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\SetupFileNames.cs" Link="SetupHost\SetupFileNames.cs" />
    <Compile Include="..\..\src\OmniEurope.Installer.Setup\InstallScope.cs" Link="SetupHost\InstallScope.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\*.json" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>InstallerTool</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\OmniEurope.Installer.Tool\bin\$(Configuration)\$(InstallerToolFramework)\oe-installer.dll'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SetupHost</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\OmniEurope.Installer.Setup\bin\$(Configuration)\net472\OmniEurope.Installer.Setup.exe'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
